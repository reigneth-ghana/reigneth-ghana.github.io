      </div>

      <div class="family">
        <h3>Alternative / Budget-Line Banding Machines</h3>
        <p class="family__intro">
          For customers who don't need the genuine Mabas SBM-90's integrated
          band printer, we also supply the DFM5540 and FM5540 &mdash; a
          separate, Chinese-manufactured line of automatic banknote banding
          machines at a lower price point.
        </p>
        <div class="model-grid model-grid--text">
          {
            budgetBandingModels.map((m) => (
              <article class="model-card">
                <div class="model-card__placeholder">
                  <svg
                    viewBox="0 0 24 24"
                    width="28"
                    height="28"
                    aria-hidden="true"
                  >
                    <path
                      fill="currentColor"
                      d="M4 7h3l1.5-2h7L17 7h3a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Zm8 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"
                    />
                  </svg>
                  <span>Photo coming soon</span>
                  <code>{m.placeholderPath}</code>
                </div>
                <div class="model-card__body">
                  <h4>{m.name}</h4>
                  <ul>
                    {m.specs.map((s) => (
                      <li set:html={s} />
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
        <div class="advisory">
          <p>
            <strong>Note:</strong> the DFM5540 and FM5540 are independently manufactured
            machines and are not Mabas products. Parts, firmware, and service procedures
            are not interchangeable with the genuine Mabas SBM-90 &mdash; let our
            technicians know which model you have when ordering spares or requesting
            service.
          </p>
        </div>
      </div>

      <div class="note">
        <img
          src="/images/products/banding-bands.jpg"
          alt="Rolls of pre-printed banknote bands"
          width="220"
          height="240"
          class="note__img"
        />
        <div class="note__body">
          <h4>Banding bands &amp; tape</h4>
          <p>
            Pre-printed and blank paper bands and film tape for banknote banding
            machines, sized to match your bank's branding and denomination
            requirements.
          </p>
        </div>
      </div>
    </section>

    <section id="coin-counting" class="product-block">
      <h2>Coin Counting Machines</h2>
      <p class="product-block__intro">
        Fast, accurate single-denomination coin counters built for continuous,
        high-volume processing.
      </p>

      <div class="product-grid product-grid--single">
        <article class="product">
          <button
            type="button"
            class="product__photo"
            data-lightbox
            data-images={JSON.stringify(["/images/products/coin-counter.jpg"])}
            data-name="Coin 100/120"
          >
            <img
              src="/images/products/coin-counter.jpg"
              alt="Coin 100/120 counting machine"
              width="420"
              height="280"
            />
            <span class="zoom-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14">
                <path
                  fill="currentColor"
                  d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"
                ></path>
              </svg>
            </span>
          </button>
          <div class="product__body">
            <h3>Coin 100/120</h3>
            <p>
              A conveniently portable, cost-effective solution for single
              denomination processing. It processes large quantities of
              pre-sorted denominations swiftly and accurately.
            </p>
            <ul>
              <li>Easy to set up and maintain</li>
              <li>Simple double-dial setup for thickness and diameter</li>
              <li>
                Continuous counting — the machine can be fed while running
              </li>
              <li>Ideal for gaming, vending, or banking use</li>
            </ul>
          </div>
        </article>
      </div>
    </section>

    <section class="wrap cta">
      <h2>Need pricing, installation, or ongoing maintenance?</h2>
      <p>
        Our technicians cover both the Southern and Northern zones of Ghana.
      </p>
      <a href="/contact" class="button button--primary">Request a quote</a>
    </section>

    <div id="lightbox" class="lightbox" aria-hidden="true">
      <div class="lightbox__backdrop" data-lightbox-close></div>
      <div class="lightbox__panel" role="dialog" aria-modal="true">
        <button
          type="button"
          class="lightbox__close"
          data-lightbox-close
          aria-label="Close"
        >
          &times;
        </button>
        <button
          type="button"
          class="lightbox__nav lightbox__nav--prev"
          data-lightbox-prev
          aria-label="Previous photo"
        >
          &lsaquo;
        </button>
        <img id="lightbox-img" src="" alt="" />
        <button
          type="button"
          class="lightbox__nav lightbox__nav--next"
          data-lightbox-next
          aria-label="Next photo"
        >
          &rsaquo;
        </button>
        <div class="lightbox__meta">
          <span id="lightbox-name"></span>
          <span id="lightbox-counter"></span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const lightbox = document.getElementById("lightbox");
  const imgEl = document.getElementById(
    "lightbox-img",
  ) as HTMLImageElement | null;
  const nameEl = document.getElementById("lightbox-name");
  const counterEl = document.getElementById("lightbox-counter");
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>(
    "[data-lightbox-prev]",
  );
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>(
    "[data-lightbox-next]",
  );

  let currentImages: string[] = [];
  let currentIndex = 0;
  let currentName = "";

  function render() {
    if (!imgEl || !nameEl || !counterEl) return;
    imgEl.src = currentImages[currentIndex] ?? "";
    imgEl.alt = currentName;
    nameEl.textContent = currentName;
    const multi = currentImages.length > 1;
    counterEl.textContent = multi
      ? `${currentIndex + 1} / ${currentImages.length}`
      : "";
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
  }

  function openLightbox(images: string[], name: string) {
    if (!lightbox || !images.length) return;
    currentImages = images;
    currentName = name;
    currentIndex = 0;
    render();
    lightbox.classList.add("is-open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("is-open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const trigger = target.closest<HTMLElement>("[data-lightbox]");
    if (trigger) {
      const raw = trigger.dataset.images ?? "[]";
      const images: string[] = JSON.parse(raw);
      openLightbox(images, trigger.dataset.name ?? "");
      return;
    }

    if (target.closest("[data-lightbox-close]")) {
      closeLightbox();
      return;
    }

    if (target.closest("[data-lightbox-prev]")) {
      currentIndex =
        (currentIndex - 1 + currentImages.length) % currentImages.length;
      render();
      return;
    }

    if (target.closest("[data-lightbox-next]")) {
      currentIndex = (currentIndex + 1) % currentImages.length;
      render();
      return;
    }
  });

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("is-open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") {
      currentIndex =
        (currentIndex - 1 + currentImages.length) % currentImages.length;
      render();
    }
    if (e.key === "ArrowRight") {
      currentIndex = (currentIndex + 1) % currentImages.length;
      render();
    }
  });
</script>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: var(--space-2);
  }

  .page-head {
    padding-block: var(--space-6) var(--space-4);
    max-width: 44rem;
  }

  .page-head__lede {
    font-size: var(--text-lg);
  }

  .product-block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .product-block__intro {
    max-width: 42rem;
    margin-bottom: var(--space-4);
  }

  .family {
    margin-bottom: var(--space-6);
  }

  .family + .family {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .family h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .family__intro {
    max-width: 42rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: var(--space-3);
  }

  .model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .model-grid--text {
    grid-template-columns: repeat(2, 1fr);
  }

  .model-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .model-card--text {
    padding: var(--space-3);
  }

  .model-card--flagship {
    position: relative;
    border-color: var(--color-brand-red);
    box-shadow: 0 0 0 1px var(--color-brand-red);
  }

  .flagship-badge {
    position: absolute;
    top: -0.6rem;
    left: var(--space-3);
    background: var(--color-brand-red);
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
