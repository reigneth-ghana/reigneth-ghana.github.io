---
import BaseLayout from "../layouts/BaseLayout.astro";

const shrinkWrapFamilies = [
  {
    brand: "Ladypack",
    intro:
      "A compact, angular packaging machine with a 90&deg; heating oven, built to provide high-quality packaging with PVC, Polypropylene, Polyolefin, or Polyethylene film. An impulse sealing system with a nickel-chrome blade cuts and seals centre-folded roll film, and a motorized conveyor feeds items into a shrink tunnel heated by armored heaters. We supply several sizes and configurations to match your throughput:",
    models: [
      {
        name: "Ladypack 45N/A2",
        flagship: true,
        images: [
          "/images/products/ladypack-45na2-1.jpg",
          "/images/products/ladypack-45na2-2.jpg",
        ],
        specs: [
          "Our flagship shrink wrap machine &mdash; combined N/A2 configuration of the Ladypack 45 footprint",
          "Touch-screen PLC control panel with guided cycle settings",
          "Impulse-seal-and-tunnel design with foot-pedal operation and an integrated film-roll holder",
        ],
      },
      {
        name: "Ladypack 45",
        images: ["/images/products/ladypack-45.jpg"],
        specs: [
          "Smallest footprint in the range &mdash; suited to lower-volume, bench-side packing runs",
          "Two conveyor-belt cycles: forward-forward or forward-reverse, selectable from the panel",
          "Handles polyethylene, PVC, polypropylene and technical films",
        ],
      },
      {
        name: "Ladypack 65",
        images: ["/images/products/ladypack-1.jpg"],
        specs: [
          "Our most-supplied configuration &mdash; wider sealing table and taller package clearance than the 45",
          "Same impulse-seal-and-tunnel design, built for steadier daily volumes",
          "Electronic control with programmable tunnel temperature, belt speed and sealing time",
        ],
      },
      {
        name: "Ladypack 110",
        images: ["/images/products/ladypack-110.jpg"],
        specs: [
          "The largest of the three &mdash; wider arch and higher throughput for high-volume floors",
          "Suited to cash centres and bulk packaging runs where the 45 or 65 would bottleneck",
          "Same conveyor-fed shrink tunnel design, scaled up",
        ],
      },
      {
        name: "Ladypack Klok 550",
        images: ["/images/products/ladypack-klok550.png"],
        specs: [
          "Larger-format model in the Ladypack line, for bigger or bulkier items",
          "Same impulse-seal-and-tunnel technology, scaled up for the 550 size",
        ],
      },
      {
        name: "Ladypack Table Top",
        images: ["/images/products/ladypack-tabletop.jpg"],
        specs: [
          "Compact bench/table-top configuration for lower-volume or space-constrained setups",
          "Same impulse-seal-and-tunnel design as the rest of the range",
        ],
      },
    ],
  },
  {
    brand: "Adpak / Smipack SL Series",
    intro:
      "The SL series is Smipack's entry-level L-sealing hood packer &mdash; designed for clear-cut market segments with a lower output, while keeping most of the features of the higher-output S series. We supply three models across the range:",
    models: [
      {
        name: "Smipack SL45",
        images: ["/images/products/smipack-sl45.jpg"],
        specs: [
          "Entry-level SL series &mdash; outputs of up to 300 packs/hour",
          "Compact single-column hood packer, suited to lighter-duty use",
        ],
      },
      {
        name: "Smipack S560N",
        images: ["/images/products/smipack-s560n.jpg"],
        specs: [
          "Part of the S series &mdash; Smipack's core industrial range, for considerably higher throughput than the SL",
          "Powered take-away conveyor for continuous, hands-off production",
        ],
      },
      {
        name: "Smipack S560NA",
        images: ["/images/products/smipack-s560na.jpg"],
        specs: [
          "Same S-series performance as the S560N, in an alternative chassis finish",
          "Manual or automatic-cycle operation with a powered take-away conveyor",
        ],
      },
    ],
  },
];

const akebonoModels = {
  brand: "Akebono OB Series",
  intro:
    "An arch-style tabletop machine for applying paper or film bands around small bundled items &mdash; banknotes, brochures, envelopes and similar flat items &mdash; using a heat-sealing system. We supply the OB-360, OB-460 and OB-560, three arch sizes built around the same reliable banding mechanism:",
  models: [
    {
      name: "Akebono OB-360",
      images: ["/images/products/akebono-ob360.jpg"],
      specs: [
        "Up to 30 banding cycles per minute",
        "Bands packages from 30mm &times; 10mm up to 420mm &times; 210mm",
        "Works with either paper or film tape, no parts change needed",
        "New track design supports 60-micron film, cutting cost and waste",
      ],
    },
    {
      name: "Akebono OB-460",
      images: null,
      placeholderPath: "/images/products/akebono-ob460.jpg",
      specs: [
        "Same heat-sealing mechanism as the OB-360, stepped up to a larger arch",
        "Suited to bundles and printed-material runs that exceed the OB-360's capacity",
        "Either paper or film tape, no parts change needed",
      ],
    },
    {
      name: "Akebono OB-560",
      images: ["/images/products/akebono-ob560.jpg"],
      specs: [
        "The largest arch in the range, for higher-volume banding floors",
        "Same reliable heat-sealing mechanism as the OB-360 and OB-460",
        "Optional large dispenser available",
      ],
    },
  ],
};

const mabasModel = {
  name: "Mabas SBM-90 Banding Machine",
  images: ["/images/products/mabas-banding.jpg"],
  copy: "A heavy-duty automatic banknote banding machine from Mabas Electronics, with an integrated ink-jet band printer.",
  specs: [
    "Prints bank name, branch name, operator name and date across 4 lines",
    "3 lines are operator-configurable (20 characters each)",
    "Date/time line is system-generated and cannot be edited",
    "Easy, quick, reliable and productive in daily use",
  ],
};

const budgetBandingModels = [
  {
    name: "DFM5540",
    images: ["/images/products/dfm5540.jpg"],
    specs: [
      "Chinese-manufactured automatic banknote banding machine",
      "Similar form factor and banding function to the genuine Mabas SBM-90, at a lower price point",
    ],
  },
  {
    name: "FM5540",
    images: ["/images/products/fm5540.jpg"],
    specs: [
      "Chinese-manufactured automatic banknote banding machine",
      "A step up from the DFM5540 within the same alternative line",
    ],
  },
];
---

<BaseLayout
  title="Products"
  description="Shrink wrap machines, bank note banding machines, coin counting machines, and supplies — the equipment Reigneth Company Limited supplies to banks and businesses across Ghana."
  activePath="/products"
>
  <main class="wrap" id="main-content">
    <header class="page-head">
      <p class="eyebrow">Our Products</p>
      <h1>Equipment banks and businesses rely on daily</h1>
      <p class="page-head__lede">
        We supply shrink wrap machines, bank note banding machines, coin
        counting machines, and the consumables that keep them running — all
        backed by our own installation, repair, and maintenance service. See the <a
          href="/services">services</a
        > we provide alongside this equipment, or grab the <a href="/downloads"
          >full spec sheet</a
        >.
      </p>
    </header>

    <section id="shrink-wrap" class="product-block">
      <h2>Shrink Wrap Machines</h2>
      <p class="product-block__intro">
        Compact, high-output packaging machines that protect your products
        efficiently and effectively.
      </p>

      {
        shrinkWrapFamilies.map((family) => (
          <div class="family">
            <h3>{family.brand}</h3>
            <p class="family__intro" set:html={family.intro} />
            <div class="model-grid">
              {family.models.map((m) =>
                m.images ? (
                  <article
                    class={`model-card${m.flagship ? " model-card--flagship" : ""}`}
                  >
                    {m.flagship && <span class="flagship-badge">Flagship</span>}
                    <button
                      type="button"
                      class="model-card__photo"
                      data-lightbox
                      data-images={JSON.stringify(m.images)}
                      data-name={m.name}
                    >
                      <img
                        src={m.images[0]}
                        alt={m.name}
                        width="360"
                        height="270"
                      />
                      <span class="zoom-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="14" height="14">
                          <path
                            fill="currentColor"
                            d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"
                          />
                        </svg>
                      </span>
                    </button>
                    <div class="model-card__body">
                      <h4>{m.name}</h4>
                      <ul>
                        {m.specs.map((s) => (
                          <li set:html={s} />
                        ))}
                      </ul>
                    </div>
                  </article>
                ) : (
                  <article class="model-card">
                    <div class="model-card__placeholder">
                      <svg
                        viewBox="0 0 24 24"
                        width="28"
                        height="28"
                        aria-hidden="true"
                      >
                        <path
                          fill="currentColor"
                          d="M4 7h3l1.5-2h7L17 7h3a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Zm8 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"
                        />
                      </svg>
                      <span>Photo coming soon</span>
                      <code>{m.placeholderPath}</code>
                    </div>
                    <div class="model-card__body">
                      <h4>{m.name}</h4>
                      <ul>
                        {m.specs.map((s) => (
                          <li set:html={s} />
                        ))}
                      </ul>
                    </div>
                  </article>
                ),
              )}
            </div>
          </div>
        ))
      }

      <div class="note">
        <img
          src="/images/products/shrink-film-rolls.jpg"
          alt="Rolls of clear shrink wrap film"
          width="220"
          height="240"
          class="note__img"
        />
        <div class="note__body">
          <h4>Shrink wrap films</h4>
          <p>
            Packaging shrink films provide a tight, secure seal that helps
            prevent tampering or damage during transportation. We supply films
            made from PVC, Polyolefin, and Polyethylene in a range of
            thicknesses and sizes to match your product requirements.
          </p>
        </div>
      </div>
    </section>

    <section id="banknote-banding" class="product-block">
      <h2>Bank Note Banding Machines</h2>
      <p class="product-block__intro">
        Advanced banding machines for secure, efficient currency handling and
        streamlined cash management, supplied to banks across Ghana.
      </p>

      <div class="family">
        <h3>{akebonoModels.brand}</h3>
        <p class="family__intro" set:html={akebonoModels.intro} />
        <div class="model-grid">
          {
            akebonoModels.models.map((m) =>
              m.images ? (
                <article class="model-card">
                  <button
                    type="button"
                    class="model-card__photo"
                    data-lightbox
                    data-images={JSON.stringify(m.images)}
                    data-name={m.name}
                  >
                    <img
                      src={m.images[0]}
