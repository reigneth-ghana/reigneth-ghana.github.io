---
import BaseLayout from "../layouts/BaseLayout.astro";

// TODO: replace placeholder contact details once confirmed (see ROADMAP open questions).
const phone = "+233 XX XXX XXXX";
const email = "info@reigneth.com.gh";
const address = "Accra, Ghana";
---

<BaseLayout title="Contact" activePath="/contact">
  <main class="wrap" id="main-content">
    <header class="page-head">
      <p class="eyebrow">Contact Us</p>
      <h1>Let's talk about your equipment needs</h1>
      <p class="page-head__lede">
        Whether it's a shrink wrap machine, a banknote banding machine, or a
        coin counter — installation, repair, or routine maintenance — our team
        is ready to help, wherever you are in Ghana.
      </p>
    </header>

    <section class="contact-grid">
      <div class="contact-info">
        <h2>Get in touch</h2>

        <ul class="info-list">
          <li>
            <span class="info-list__label">Phone</span>
            <a href={`tel:${phone.replace(/\s+/g, "")}`}>{phone}</a>
          </li>
          <li>
            <span class="info-list__label">Email</span>
            <a href={`mailto:${email}`}>{email}</a>
          </li>
          <li>
            <span class="info-list__label">Address</span>
            <span>{address}</span>
          </li>
          <li>
            <span class="info-list__label">Coverage</span>
            <span
              >Southern Zone &amp; Northern Zone technicians, nationwide</span
            >
          </li>
        </ul>

        <p class="info-note">
          Contact details above are placeholders — swap in the confirmed phone,
          email, address and any social links.
        </p>
      </div>

      <form
        class="contact-form"
        method="post"
        action={`mailto:${email}`}
        enctype="text/plain"
      >
        <h2>Send a message</h2>

        <label>
          Name
          <input type="text" name="name" required />
        </label>

        <label>
          Email
          <input type="email" name="email" required />
        </label>

        <label>
          Phone
          <input type="tel" name="phone" />
        </label>

        <label>
          What do you need?
          <select name="service">
            <option value="">Select a service</option>
            <option value="Shrink wrap machines">Shrink wrap machines</option>
            <option value="Bank note banding machines"
              >Bank note banding machines</option
            >
            <option value="Coin counting machines"
              >Coin counting machines</option
            >
            <option value="Other">Other</option>
          </select>
        </label>

        <label>
          Message
          <textarea name="message" rows="5" required></textarea>
        </label>

        <button type="submit" class="button button--primary"
          >Send message</button
        >
        <p class="form-note">
          This opens your email client to send the message directly to us.
        </p>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: var(--space-2);
  }

  .page-head {
    padding-block: var(--space-6) var(--space-4);
    max-width: 44rem;
  }

  .page-head__lede {
    font-size: var(--text-lg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .info-list {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .info-list__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brass-text);
  }

  .info-note {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    border-left: var(--band-width) solid var(--color-brass);
    padding-left: var(--space-2);
  }

  .contact-form {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 1px;
  }

  .contact-form button {
    margin-top: var(--space-1);
    align-self: flex-start;
  }

  .form-note {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
