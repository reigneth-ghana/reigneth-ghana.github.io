---
import BaseLayout from "../layouts/BaseLayout.astro";

const specialties = [
  {
    id: "shrink-wrap",
    title: "Shrink Wrap Machine Services",
    copy: "We provide high-quality shrink wrap machines designed to protect your products efficiently and effectively. Our team is equipped to handle installations, repairs, and routine maintenance to ensure your operations run smoothly.",
    linkLabel: "See shrink wrap machines we support",
    href: "/products#shrink-wrap",
  },
  {
    id: "banknote-banding",
    title: "Bank Note Banding Machine Services",
    copy: "Serving all banks across Ghana, we supply and maintain advanced bank note banding machines. These machines ensure the secure and efficient handling of currency, helping banks streamline their cash management processes.",
    linkLabel: "See banding machines we support",
    href: "/products#banknote-banding",
  },
  {
    id: "coin-counting",
    title: "Coin Counting Machine Services",
    copy: "From setup to routine servicing, we keep coin counting equipment running accurately for gaming, vending, and banking operations that handle bulk batches of coins or tokens.",
    linkLabel: "See coin counters we support",
    href: "/products#coin-counting",
  },
];

const process = [
  {
    title: "Supply",
    copy: "We source and supply quality equipment from reputable manufacturers, matched to your volume and budget.",
  },
  {
    title: "Installation",
    copy: "Our technicians set up and commission your equipment on-site, so it's ready to run from day one.",
  },
  {
    title: "Repairs & Maintenance",
    copy: "Routine servicing and responsive repairs keep your equipment in optimal condition and minimize downtime.",
  },
  {
    title: "Nationwide Support",
    copy: "Technicians in both the Southern and Northern zones mean support is never far away, wherever you're located in Ghana.",
  },
];
---

<BaseLayout
  title="Services"
  description="Supply, installation, repairs, and maintenance for shrink wrap machines, bank note banding machines, and coin counting equipment — from Reigneth Company Limited, Ghana."
  activePath="/services"
>
  <main class="wrap" id="main-content">
    <header class="page-head">
      <p class="eyebrow">Our Services</p>
      <h1>Installation, repairs, and maintenance you can rely on</h1>
      <p class="page-head__lede">
        Beyond supplying quality equipment, we keep it running. Our technicians
        handle installation, repairs, and routine maintenance for the machines
        banks and businesses depend on every day — browse the
        <a href="/products">equipment we support</a> or get in touch for a quote.
      </p>
    </header>

    <section class="service-block">
      <h2>Specialized Services</h2>
      <p class="service-block__intro">
        Our primary goal is to ensure that our customers and prospective clients
        receive the best quality products and unparalleled maintenance services,
        built on trust, reliability, and satisfaction.
      </p>

      <div class="specialty-grid">
        {
          specialties.map((s) => (
            <article id={s.id} class="specialty">
              <h3>{s.title}</h3>
              <p>{s.copy}</p>
              <a href={s.href} class="specialty__link">
                {s.linkLabel} &rarr;
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="process-block">
      <h2>How we work</h2>
      <div class="process-grid">
        {
          process.map((p, i) => (
            <div class="process-item">
              <span class="process-item__index">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{p.title}</h3>
              <p>{p.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap cta">
      <h2>Need installation, repairs, or routine maintenance?</h2>
      <p>
        Our technicians cover both the Southern and Northern zones of Ghana.
      </p>
      <a href="/contact" class="button button--primary">Request a quote</a>
    </section>
  </main>
</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: var(--space-2);
  }

  .page-head {
    padding-block: var(--space-6) var(--space-4);
    max-width: 44rem;
  }

  .page-head__lede {
    font-size: var(--text-lg);
  }

  .service-block,
  .process-block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .service-block__intro {
    max-width: 42rem;
    margin-bottom: var(--space-4);
  }

  .specialty-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .specialty {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: var(--band-width) solid var(--color-brand-red);
    border-radius: 4px;
    padding: var(--space-3);
  }

  .specialty h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .specialty p {
    font-size: var(--text-sm);
    flex: 1;
  }

  .specialty__link {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-top: var(--space-1);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .process-item {
    border-top: var(--band-width) solid var(--color-brass);
    padding-top: var(--space-2);
  }

  .process-item__index {
    display: block;
    font-family: var(--font-mono);
    color: var(--color-brass-text);
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .process-item h3 {
    font-size: var(--text-base);
  }

  .process-item p {
    font-size: var(--text-sm);
  }

  .cta {
    text-align: center;
    padding-block: var(--space-8);
  }

  .cta p {
    margin-inline: auto;
  }

  .cta .button {
    margin-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .specialty-grid {
      grid-template-columns: 1fr;
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
