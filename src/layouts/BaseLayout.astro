---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
}

const {
  title,
  description = "Reigneth Company Limited — CIT solutions, general merchant, and office equipment supplier in Ghana.",
  activePath = "",
} = Astro.props;

const pageTitle = `${title} | Reigneth Company Limited`;
const ogImageUrl = new URL("/images/og/og-image.jpg", Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Reigneth Company Limited" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header activePath={activePath} />
    <slot />
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -3rem;
    left: var(--space-2);
    z-index: 100;
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 0.6rem 1rem;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-2);
  }
</style>
