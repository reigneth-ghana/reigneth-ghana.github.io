---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__about">
      <img
        src="/images/logo/rcl-logo.jpg"
        alt="Reigneth Company Limited"
        width="40"
        height="40"
      />
      <p>
        Cash-in-transit solutions, general merchandise, and office equipment —
        serving banks and businesses across Ghana.
      </p>
    </div>

    <div class="site-footer__col">
      <h4>Company</h4>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/about#team">Leadership</a></li>
        <li><a href="/about#coverage">Coverage</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4>Services</h4>
      <ul>
        <li><a href="/services#shrink-wrap">Shrink wrap machines</a></li>
        <li>
          <a href="/services#banknote-banding">Banknote banding machines</a>
        </li>
        <li><a href="/services#coin-counting">Coin counting machines</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4>Coverage</h4>
      <ul class="site-footer__zones">
        <li>Southern Zone technicians</li>
        <li>Northern Zone technicians</li>
        <li><a href="/contact">Get in touch &rarr;</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <p>&copy; {year} Reigneth Company Limited.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    border-top: calc(var(--band-width) * 2) solid var(--color-brand-red);
    margin-top: var(--space-8);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-4);
  }

  .site-footer__about img {
    margin-bottom: var(--space-2);
    filter: grayscale(1) brightness(1.6);
  }

  .site-footer__about p {
    color: #c9c6c3;
    font-size: var(--text-sm);
    max-width: 22rem;
  }

  .site-footer h4 {
    font-family: var(--font-display);
    color: var(--color-surface);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer a {
    color: #c9c6c3;
    font-size: var(--text-sm);
  }

  .site-footer a:hover {
    color: var(--color-surface);
  }

  .site-footer__zones a {
    color: var(--color-brand-red);
    font-weight: 600;
  }

  .site-footer__zones a:hover {
    color: #c9422e;
  }

  .site-footer__bottom {
    border-top: 1px solid #3a3735;
    padding-block: var(--space-2);
  }

  .site-footer__bottom p {
    color: #8c8985;
    font-size: var(--text-xs);
    margin: 0;
  }

  @media (max-width: 780px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
